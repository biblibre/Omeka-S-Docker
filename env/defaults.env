# -----------------------------------------------------------------------------
# Omeka-S-Docker - default configuration
#
# Copy this file to `.env` at the repository root and adjust the values:
#     cp env/defaults.env .env
#
# `.env` is not versioned: it is your local configuration.
# -----------------------------------------------------------------------------

# --- omeka image ----------------------------------------------------------
OMEKA_S_VERSION=4.1.1
PHP_VERSION=8.2
APPLICATION_ENV=development

# --- database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=omeka_admin
MYSQL_DATABASE=omeka
MYSQL_USER=omeka
MYSQL_PASSWORD=omeka
MYSQL_HOST=db
MYSQL_PORT=3306
MARIADB_VERSION=11.4

# --- Solr -------------------------------------------------------------
SOLR_VERSION=9
SOLR_CORE=default

# --- SMTP (Mailpit, with `otd --smtp`) --------------------------------
# port: 25, 465 for 'ssl', 587 for 'tls' ; connection type: 'null', 'ssl', 'tls'
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TYPE=null

# --- modules & themes ------------------------------------------------
# OMEKA_S_MODULES: registry ids (https://omeka.org/add-ons/), "Name:version",
#                  or ZIP URLs. Downloaded at startup; installed when
#                  OMEKA_S_INSTALL_MODULES=1.
# OMEKA_S_DEV_MODULES: names of host-mounted modules (otd --module) to install.
OMEKA_S_MODULES=""
OMEKA_S_DEV_MODULES=""
OMEKA_S_THEMES="default"
OMEKA_S_INSTALL_MODULES=0
OMEKA_S_ALLOW_EASY_ADMIN=0

# --- core installation at first boot -------------------------------
# 1 = install the Omeka S core automatically on first boot.
OMEKA_S_INSTALL_CORE=0
OMEKA_S_TITLE="Omeka S"
OMEKA_S_TIME_ZONE="UTC"
OMEKA_S_LOCALE="en_US"
OMEKA_S_ADMIN_NAME="admin"
OMEKA_S_ADMIN_EMAIL="admin@example.com"
OMEKA_S_ADMIN_PASSWORD="admin"

# --- host-published ports ----------------------------------------
OMEKA_S_EXPOSED_PORT=8080
PHPMYADMIN_EXPOSED_PORT=8081
SOLR_EXPOSED_PORT=8983
MAILPIT_EXPOSED_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- application user UID/GID (injected by `otd`) ---------------
LOCAL_UID=1000
LOCAL_GID=1000
